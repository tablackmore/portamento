{
  "name": "@portamento/core",
  "version": "0.1.0",
  "description": "Portable playlist transfer between Spotify, Tidal and YouTube. JSPF format, PKCE auth, ISRC-first matching. Browser-first, zero dependencies.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "vitest": "^2.1.4"
  },
  "keywords": [
    "playlist",
    "spotify",
    "tidal",
    "youtube",
    "jspf",
    "xspf",
    "isrc",
    "music"
  ],
  "license": "MIT"
}
